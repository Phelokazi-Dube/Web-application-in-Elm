<%= if Map.has_key?(assigns, :extra_prepend) do %>
  <div style="margin: 1rem 0; padding: 1rem; border: 1px solid #4caf50; border-radius: 8px; background-color: #e8f5e9; color: #2e7d32;">
    <%= raw(@extra_prepend) %>
  </div>
<% end %>

<% IO.inspect(@profile, label: "Profile Data") %>

<div id="myapp"></div>
<script type="module">
  <%= raw "import { start_elm } from \"/js/" <> @js_file <> ".js\";" %>
  const flags = {
    baseUrl: window.location.origin,
    csrfToken: document.querySelector('meta[name="csrf-token"]').getAttribute('content')
  };
  const app = start_elm(flags);
</script>
<script>
</script>