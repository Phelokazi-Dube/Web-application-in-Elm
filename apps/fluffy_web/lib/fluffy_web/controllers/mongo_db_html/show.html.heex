<!-- Custom styles -->
<style>
  @import url('https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&display=swap');

  body {
    font-family: 'Quicksand', sans-serif;
    background-color: #f8f9fa;
  }

  h1 {
    background: linear-gradient(to right, #4facfe, #00f2fe);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-size: 2.5rem;
    margin-bottom: 1rem;
    font-weight: 700;
    text-align: center;
  }

  .tabs {
    display: flex;
    justify-content: center;
    gap: 1rem;
    border-bottom: 2px solid #ddd;
    margin-bottom: 1rem;
  }

  .tab {
    padding: 0.6rem 1.2rem;
    font-weight: 600;
    cursor: pointer;
    border-radius: 6px 6px 0 0;
    background: #eee;
    transition: background-color 0.3s;
  }

  .tab.active {
    background: #4facfe;
    color: #fff;
  }

  .tab-content {
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 0 0 12px 12px;
    padding: 1.5rem;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
  }

  table th {
    color: #0d47a1;
    font-weight: 600;
    text-transform: capitalize;
  }

  table td {
    vertical-align: top;
  }

  .img-thumbnail {
    border: 2px solid #ddd;
    border-radius: 8px;
    padding: 4px;
    background: #fff;
    max-height: 250px;
  }

  .btn-warning {
    background-color: #ffc107;
    color: #000;
    border: none;
    border-radius: 8px;
    padding: 10px 16px;
    text-decoration: none;
    font-weight: 600;
    transition: background-color 0.3s ease;
  }

  .btn-warning:hover {
    background-color: #e0a800;
  }

  .edit-button {
    display: flex;
    justify-content: center;
    margin-top: 1.5rem;
  }

  .pdf-card {
    min-height: 220px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;

    word-break: break-word;
    overflow-wrap: anywhere;
  }

  .pdf-preview {
    font-size: 10rem;
    background: #f1f5f9;
    border-radius: 12px;
    width: 100%;
    height: 160px;

    display: flex;
    align-items: center;
    justify-content: center;

    color: #ef4444;
    margin-bottom: 0.75rem;
  }

</style>

<h1>Document Details</h1>

<div class="general-page container mx-auto px-4 py-3 justify-between animate-fade-in">
  <!-- Tabs -->
  <div class="tabs" id="tabs">
    <div class="tab active" data-tab="general">General</div>
    <div class="tab" data-tab="images">Images</div>
    <div class="tab" data-tab="publications">Publications</div>
  </div>

  <!-- Tab Contents -->
  <div id="tab-general" class="tab-content active">
    <table class="table table-striped table-bordered">
      <tbody>
        <%= for {key, value} <- @document do %>
          <%= if key not in ["photos", "created_at", "date_dt", "publications"] do %>
            <tr>
              <th><%= Phoenix.Naming.humanize(key) %></th>
              <td>
                <%= case {key, value} do %>
                  <% {key, ts} when key in ["approved_at", "updated_at"] and is_integer(ts) -> %>
                    <%= with {:ok, dt} <- DateTime.from_unix(ts),
                            {:ok, sast_dt} <- DateTime.shift_zone(dt, "Africa/Johannesburg") do
                          Calendar.strftime(sast_dt, "%d %B %Y %H:%M SAST")
                        else
                          _ ->
                            {:ok, dt} = DateTime.from_unix(ts)
                            Calendar.strftime(dt, "%d %B %Y %H:%M UTC")
                        end %>
                   <% {"location", %{"coordinates" => [longitude, latitude]}} -> %>
                    Longitude: <%= longitude %>, Latitude: <%= latitude %>
                    
                  <% {_, v} when is_map(v) -> %>
                    <pre><%= inspect(v) %></pre>

                  <% {_, v} when is_list(v) -> %>
                    <ul>
                      <%= for item <- v do %>
                        <li><%= item %></li>
                      <% end %>
                    </ul>

                  <% {_, v} -> %>
                    <%= v %>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>

  <div id="tab-images" class="tab-content hidden">
    <%= if photos = Map.get(@document, "photos") do %>
      <div class="d-flex flex-wrap gap-3 justify-content-center">
        <%= for id <- photos do %>
          <img 
            src={~p"/image/#{id}"}
            alt="Photo"
            class="img-thumbnail"
            onerror="this.onerror=null; this.src='/images/fallback.jpg';"
          />
        <% end %>
      </div>
    <% else %>
      <p>No images available.</p>
    <% end %>
  </div>

  <div id="tab-publications" class="tab-content hidden">
    <%= if publications = Map.get(@document, "publications") do %>
      <div class="d-flex flex-wrap gap-4 justify-content-center">
        <%= for id <- publications do %>
          <div class="pdf-card border rounded-xl p-4 shadow-sm bg-white
                      max-w-sm w-full sm:w-80 md:w-96 text-center">

            <div class="pdf-preview">📄</div>

            <a
              href={~p"/publication/#{id}"}
              target="_blank"
              class="btn btn-warning w-full mt-2"
            >
              View / Download PDF
            </a>
          </div>
        <% end %>
      </div>
    <% else %>
      <p><i>No publications attached.</i></p>
    <% end %>
  </div>

  <%= if @collection && @collection != "" && @can_edit do %>
    <div class="edit-button">
      <a href={"?collection=#{@collection}&edit=true"} class="btn btn-warning">
        ✏️ Edit Document
      </a>
    </div>
  <% end %>
</div>

<!-- Tab Switching Script -->
<script>
  const tabs = document.querySelectorAll('.tab');
  const contents = document.querySelectorAll('.tab-content');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      // Remove active classes
      tabs.forEach(t => t.classList.remove('active'));
      contents.forEach(c => c.classList.add('hidden'));

      // Add active classes
      tab.classList.add('active');
      const activeContent = document.getElementById('tab-' + tab.dataset.tab);
      activeContent.classList.remove('hidden');
    });
  });
</script>