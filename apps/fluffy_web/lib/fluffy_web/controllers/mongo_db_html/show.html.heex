<div class="document-details-page site-content-width animate-fade-in">
  <div class="document-details-header">
    <h1 class="document-details-title">Document Details</h1>
    <p class="document-details-description">
      View the record information and any associated attachments.
    </p>
  </div>
  <!-- Tabs -->
  <div class="document-tabs" id="tabs">
    <button type="button" class="document-tab active" data-tab="general">
      General
    </button>

    <%= if @collection == "Surveys" do %>
      <button type="button" class="document-tab" data-tab="images">
        Images
      </button>

      <button type="button" class="document-tab" data-tab="publications">
        Publications
      </button>
    <% end %>
  </div>

  <!-- Tab Contents -->
  <div id="tab-general" class="document-tab-content active">
    <div class="document-details-table-wrapper">
      <table class="document-details-table">
        <tbody>
          <%= for {key, value} <- Enum.sort_by(@document, fn {key, _value} -> String.downcase(key) end) do %>
            <%= if key not in ["photos", "created_at", "date_dt", "publications"] do %>
              <tr>
                <th><%= Phoenix.Naming.humanize(key) %></th>
                <td>
                  <%= case {key, value} do %>
                    <% {"date", date_str} when is_binary(date_str) -> %>
                      <%= case FluffyWeb.ControllerHelpers.parse_date_string(date_str) do %>
                        <% %Date{} = date -> %>
                          <%= Calendar.strftime(date, "%d %B %Y") %>
                        <% _ -> %>
                          <%= date_str %>
                      <% end %>
                    <% {key, ts} when key in ["approved_at", "updated_at"] and is_integer(ts) -> %>
                      <%= with {:ok, dt} <- DateTime.from_unix(ts),
                              {:ok, sast_dt} <- DateTime.shift_zone(dt, "Africa/Johannesburg") do
                            Calendar.strftime(sast_dt, "%d %B %Y %H:%M SAST")
                          else
                            _ ->
                              {:ok, dt} = DateTime.from_unix(ts)
                              Calendar.strftime(dt, "%d %B %Y %H:%M UTC")
                          end %>
                    <% {"location", %{"coordinates" => [longitude, latitude]}} -> %>
                      Longitude: <%= longitude %>, Latitude: <%= latitude %>
                      
                    <% {_, v} when is_map(v) -> %>
                      <pre><%= inspect(v) %></pre>

                    <% {_, v} when is_list(v) -> %>
                      <ul>
                        <%= for item <- v do %>
                          <li><%= item %></li>
                        <% end %>
                      </ul>

                    <% {_, v} -> %>
                      <%= v %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
      </div>
    </div>

  <%= if @collection == "Surveys" do %>
    <div id="tab-images" class="document-tab-content hidden">
      <%= if photos = Map.get(@document, "photos") do %>
        <div class="document-images-grid">
          <%= for id <- photos do %>
            <img 
              src={~p"/image/#{id}"}
              alt="Photo"
              class="document-image"
              onerror="this.onerror=null; this.src='/images/fallback.jpg';"
            />
          <% end %>
        </div>
      <% else %>
        <p>No images available.</p>
      <% end %>
    </div>

    <div id="tab-publications" class="document-tab-content hidden">
      <%= if publications = Map.get(@document, "publications") do %>
        <div class="document-publications-grid">
          <%= for id <- publications do %>
            <div class="document-publication-card">

              <div class="document-pdf-preview">📄</div>

              <a
                href={~p"/publication/#{id}"}
                target="_blank"
                class="document-publication-button"
              >
                View / Download PDF
              </a>
            </div>
          <% end %>
        </div>
      <% else %>
        <p><i>No publications attached.</i></p>
      <% end %>
    </div>
  <% end %>

  <%= if @collection && @collection != "" && @can_edit do %>
    <div class="document-edit-actions">
      <a
        href={"?collection=#{@collection}&edit=true"}
        class="document-edit-button"
      >
        ✏️ Edit Document
      </a>

      <button
        type="button"
        class="document-delete-button"
        id="open-delete-modal"
      >
        🗑️ Delete Document
      </button>
    </div>

    <div
      id="delete-document-modal"
      class="document-delete-modal hidden"
      role="dialog"
      aria-modal="true"
      aria-labelledby="delete-modal-title"
    >
      <div
        class="document-delete-modal-backdrop"
        id="delete-modal-backdrop"
      >
      </div>

      <div class="document-delete-modal-content">
        <h2 id="delete-modal-title">
          Delete this document?
        </h2>

        <p>
          This document will be permanently removed. If you entered this
          record incorrectly and want to start again, you can delete it
          and create a new one.
        </p>

        <p class="document-delete-warning">
          This action cannot be undone.
        </p>

        <div class="document-delete-modal-actions">
          <button
            type="button"
            class="document-delete-cancel-button"
            id="cancel-delete"
          >
            Cancel
          </button>

          <form
            action={~p"/documents/#{@document_id}/delete"}
            method="post"
          >
            <input
              type="hidden"
              name="_csrf_token"
              value={Plug.CSRFProtection.get_csrf_token()}
            />

            <input
              type="hidden"
              name="collection"
              value={@collection}
            />

            <button
              type="submit"
              class="document-delete-confirm-button"
            >
              Delete Document
            </button>
          </form>
        </div>
      </div>
    </div>
  <% end %>

  </div>

<!-- Tab Switching Script -->
<script>
  const tabs = document.querySelectorAll('.document-tab');
  const contents = document.querySelectorAll('.document-tab-content');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      contents.forEach(c => c.classList.add('hidden'));

      tab.classList.add('active');

      const activeContent =
        document.getElementById('tab-' + tab.dataset.tab);

      activeContent.classList.remove('hidden');
    });
  });

  // Delete confirmation modal
  const deleteModal =
    document.getElementById('delete-document-modal');

  const openDeleteModal =
    document.getElementById('open-delete-modal');

  const cancelDelete =
    document.getElementById('cancel-delete');

  const deleteModalBackdrop =
    document.getElementById('delete-modal-backdrop');

  if (deleteModal && openDeleteModal) {
    openDeleteModal.addEventListener('click', () => {
      deleteModal.classList.remove('hidden');
    });
  }

  if (deleteModal && cancelDelete) {
    cancelDelete.addEventListener('click', () => {
      deleteModal.classList.add('hidden');
    });
  }

  if (deleteModal && deleteModalBackdrop) {
    deleteModalBackdrop.addEventListener('click', () => {
      deleteModal.classList.add('hidden');
    });
  }

  document.addEventListener('keydown', event => {
    if (
      event.key === 'Escape' &&
      deleteModal &&
      !deleteModal.classList.contains('hidden')
    ) {
      deleteModal.classList.add('hidden');
    }
  });
</script>