<!-- upload_empty.html.heex -->

<div class="upload-empty-page site-content-width animate-fade-in">
  <div class="upload-empty-card">
    <div class="upload-empty-icon">!</div>

    <h1 class="upload-empty-title">Empty CSV File</h1>

    <p class="upload-empty-description">
      It looks like the CSV file you uploaded is empty or contains no valid data.
      Please make sure your file has headers and rows before uploading again.
    </p>

    <a
      href={"/csvupload?collection=#{@collection}"}
      class="upload-empty-button"
    >
      Back to CSV Upload
    </a>
  </div>
</div>
