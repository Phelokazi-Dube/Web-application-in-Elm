<div class="upload-success-page site-content-width animate-fade-in">
  <div class="upload-success-card">
    <div class="upload-success-icon">
      <i class="bi bi-check-lg"></i>
    </div>

    <h1 class="upload-success-title">
      Upload Successful
    </h1>

    <p class="upload-success-description">
      Your CSV file has been successfully processed.
    </p>

    <div class="upload-success-summary">
      <span class="upload-success-count">
        <%= @processed_count %>
      </span>

      <span class="upload-success-label">
        records processed for <strong><%= @collection %></strong>
      </span>
    </div>

    <a
      href={"/csvupload?collection=#{@collection}"}
      class="upload-success-button"
    >
      Upload Another CSV
    </a>
  </div>
</div>