<!-- upload_success.html.heex -->
<div class="upload-success p-10 max-w-2xl mx-auto text-center bg-white rounded-2xl shadow-xl">
  <h2 class="text-4xl font-extrabold text-green-600 mb-6">Upload Successful</h2>
  <p class="mb-8 text-lg text-gray-800">
    Your CSV file has been successfully uploaded and processed.
    <br />
    You can upload another csv file for this collection using the button below. 
  </p>
  <a href={"/csvupload?collection=#{@collection}"} class="inline-block px-6 py-3 text-lg bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition duration-200">
    Back to Upload Page
  </a>
</div>
