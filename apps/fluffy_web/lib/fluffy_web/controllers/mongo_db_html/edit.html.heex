<div class="edit-page animate-fade-in">
  <div class="edit-card">
    <h1 class="edit-title">Edit Document</h1>

    <div class="edit-warning">
      <strong>⚠️ Please note:</strong>
      Saving changes will mark this document as unapproved and it will need to be reviewed again.
    </div>

    <form
        action={~p"/documents/#{@document["id"]}/update"}
        method="post"
        enctype="multipart/form-data"
    >
        <input
        type="hidden"
        name="_csrf_token"
        value={Plug.CSRFProtection.get_csrf_token()}
        />

        <input
        type="hidden"
        name="collection"
        value={@collection}
        />

        <% excluded_fields = [
        "id",
        "_id",
        "photos",
        "publications",
        "userLogin",
        "approved",
        "approved_by",
        "approved_at",
        "created_at",
        "updated_by",
        "updated_at",
        "date_dt"
        ] %>

        <%= for {key, value} <- @document do %>
        <%= if key not in excluded_fields do %>
            <div class="edit-field">
            <label for={key}>
                <%= Phoenix.Naming.humanize(key) %>
            </label>

            <%= case value do %>

                <% value when is_boolean(value) -> %>
                <select
                    id={key}
                    name={key}
                >
                    <option value="true" selected={value == true}>True</option>
                    <option value="false" selected={value == false}>False</option>
                </select>

                <% value when is_list(value) -> %>
                <textarea
                    id={key}
                    name={key}
                    rows="4"
                ><%= Enum.join(value, ", ") %></textarea>

                <% value when is_map(value) -> %>
                <textarea
                    id={key}
                    name={key}
                    rows="5"
                ><%= Jason.encode!(value) %></textarea>

                <% _ -> %>
                <input
                    id={key}
                    name={key}
                    type="text"
                    value={value}
                />

            <% end %>
            </div>
        <% end %>
        <% end %>

        <%= if @collection == "Surveys" do %>
          <div class="edit-attachments">
            <h2 class="edit-attachments-title">Attachments</h2>

            <p class="edit-attachments-description">
              Add new images or publications to this survey.
              Existing attachments will be kept.
            </p>

            <div class="edit-field">
              <label for="photos">
                Add Images
              </label>

              <input
                id="photos"
                type="file"
                name="photos[]"
                accept="image/*"
                multiple
              />
            </div>

            <div class="edit-field">
              <label for="publications">
                Add Publications
              </label>

              <input
                id="publications"
                type="file"
                name="publications[]"
                accept="application/pdf"
                multiple
              />
            </div>
          </div>
        <% end %>

        <div class="edit-actions">
          <button
            type="submit"
            class="save-button"
          >
            💾 Save Changes
          </button>

          <a
            href={~p"/documents/#{@document["id"]}?collection=#{@collection}"}
            class="cancel-button"
          >
            Cancel
          </a>
        </div>
    </form>
    </div>
    </div>