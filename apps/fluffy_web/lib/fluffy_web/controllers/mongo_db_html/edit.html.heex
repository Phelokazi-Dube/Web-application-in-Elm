
<%
  identity_fields =
    case @collection do
      "Surveys" -> ["surveyId"]
      "SurveyWeedAgent" -> ["swaid"]
      "SiteInspections" -> ["siteInspectionId"]
      "SiteInspectionWeeds" -> ["siteInspectionWeedId"]
      "Locations" -> ["locationId"]
      "Districts" -> ["districtId"]
      "Regions" -> ["regionId"]
      "Continents" -> ["continentId"]
      "Countries" -> ["countryId", "continentId"]
      "Implementers" -> ["implementerId"]
      "WeedNames" -> ["weedId"]
      "ControlAgents" -> ["controlAgentId"]
      "SurveyControlAgents" -> ["id"]
      "WHMeasurements" -> ["whmid"]
      "BAR" -> ["barId"]
      _ -> []
    end

  excluded_fields = [
    "id",
    "_id",
    "photos",
    "publications",
    "userLogin",
    "approved",
    "approved_by",
    "approved_at",
    "created_at",
    "updated_by",
    "updated_at",
    "geospatialCoordinates",
    "date_dt"
  ] ++ identity_fields
%>

<div class="edit-page animate-fade-in">
  <div class="edit-card">
    <h1 class="edit-title">Edit Document</h1>

    <div class="edit-warning">
      <strong>⚠️ Please note:</strong>
      Saving changes will mark this document as unapproved and it will need to be reviewed again.
    </div>

    <form
      action={~p"/documents/#{@document["id"]}/update"}
      method="post"
      enctype="multipart/form-data"
    >
      <input
        type="hidden"
        name="_csrf_token"
        value={Plug.CSRFProtection.get_csrf_token()}
      />

      <input
        type="hidden"
        name="collection"
        value={@collection}
      />

      <%= if @back_url do %>
        <input type="hidden" name="return" value={@back_url} />
      <% end %>

      <%= for {key, value} <- @document do %>
        <%= if key not in excluded_fields do %>
          <div class="edit-field">
            <label for={key}>
              <%= Phoenix.Naming.humanize(key) %>
            </label>

            <%= cond do %>
              <% is_boolean(value) -> %>
                <select id={key} name={key}>
                  <option value="true" selected={value == true}>True</option>
                  <option value="false" selected={value == false}>False</option>
                </select>

              <% is_list(value) -> %>
              <textarea
                id={key}
                name={key}
                rows="4"
              ><%= Jason.encode!(value) %></textarea>

              <small>
                Edit the list using JSON format, for example:
                ["Agent A", "Agent B"]
              </small>

              <% is_map(value) -> %>
                <textarea
                  id={key}
                  name={key}
                  rows="5"
                ><%= Jason.encode!(value) %></textarea>

                <small>
                  Edit this field using valid JSON object format.
                </small>

              <% true -> %>
                <input
                  id={key}
                  name={key}
                  type="text"
                  value={value}
                />

            <% end %>
          </div>
        <% end %>
      <% end %>

      <%= if @collection in ["Surveys", "Sites", "Locations"] do %>
          <%= for field <- ["latitude", "longitude"] do %>
            <%= if not Map.has_key?(@document, field) do %>
              <div class="edit-field">
                <label for={field}>
                  <%= Phoenix.Naming.humanize(field) %>
                </label>

                <input
                  id={field}
                  name={field}
                  type="text"
                  placeholder={"Enter #{field}"}
                />
              </div>
            <% end %>
          <% end %>
        <% end %>

      <%= if @collection == "Surveys" do %>
          <div class="edit-attachments">
            <h2 class="edit-attachments-title">Attachments</h2>

            <p class="edit-attachments-description">
              Add new images or publications to this survey.
              Existing attachments will be kept.
            </p>

            <div class="edit-field">
              <label for="photos">
                Add Images
              </label>

              <input
                id="photos"
                type="file"
                name="photos[]"
                accept="image/*"
                multiple
              />
            </div>

            <div class="edit-field">
              <label for="publications">
                Add Publications
              </label>

              <input
                id="publications"
                type="file"
                name="publications[]"
                accept="application/pdf"
                multiple
              />
            </div>
          </div>
        <% end %>
      <div class="edit-actions">
        <button 
          type="submit" 
            class="save-button"
            >
          💾 Save Changes
        </button>

        <a
          href={~p"/documents/#{@document["id"]}?collection=#{@collection}" <>
            if(@back_url, do: "&return=" <> URI.encode_www_form(@back_url), else: "")}
          class="cancel-button"
        >
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>