<div class="upload-error-page site-content-width animate-fade-in">
  <div class="upload-error-card">
    <div class="upload-error-icon">
      <i class="bi bi-exclamation-triangle"></i>
    </div>

    <h1 class="upload-error-title">
      <%= @title %>
    </h1>

    <p class="upload-error-description">
      <%= @message %>
    </p>

    <div class="upload-error-details">
      <p class="upload-error-details-title">
        Required CSV field(s):
      </p>

      <div class="upload-error-fields">
        <%= for field <- @required_fields do %>
          <span class="upload-error-field"><%= field %></span>
        <% end %>
      </div>
    </div>

    <a
      href={"/csvupload?collection=#{@collection}"}
      class="upload-error-button"
    >
      Choose Another CSV
    </a>
  </div>
</div>